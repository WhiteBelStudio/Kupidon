# Telegram
# Реальный токен НЕ хранить в GitHub.
# Получить новый токен для @RUKupidonBot через BotFather и указать его
# в переменных окружения на API/Bot-сервере.
BOT_TOKEN=PUT_NEW_BOT_TOKEN_HERE

# Vercel Mini App
# После первого деплоя замени на реальный адрес проекта Vercel.
WEBAPP_URL=https://your-kupidon.vercel.app

# FastAPI API
# Это НЕ адрес Vercel. Здесь должен быть публичный HTTPS-адрес API.
API_URL=https://your-api.example.com

# SQLite / files (на сервере API/Bot)
DATABASE_PATH=data/kupidon.db
UPLOAD_DIR=data/uploads

# Разрешённый origin Mini App.
# Для нескольких адресов разделяй запятыми.
CORS_ORIGINS=https://your-kupidon.vercel.app

# Telegram ID администраторов через запятую.
ADMIN_IDS=7680837373

# Development-only authentication fallback.
# В production обязательно false.
DEBUG=false
DEV_TELEGRAM_ID=0

# Сколько открытых жалоб нужно для автоматического скрытия профиля.
REPORT_THRESHOLD=3
