{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm install && npx vite build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "rewrites": [
    {
      "source": "/api/profile",
      "destination": "/api/index"
    },
    {
      "source": "/api/profile/photo",
      "destination": "/api/index"
    },
    {
      "source": "/api/search",
      "destination": "/api/index"
    },
    {
      "source": "/api/matches",
      "destination": "/api/index"
    },
    {
      "source": "/api/users/:path*",
      "destination": "/api/index"
    }
  ]
}
